{
  "name": "@boxraiser/visual-editor-svelte",
  "version": "1.0.0-beta.1",
  "description": "A powerful visual page builder with real-time preview and 14 field types, built with Svelte 5. 40-60% smaller bundle size than the React version.",
  "type": "module",
  "homepage": "https://github.com/boxraiser/visual-editor-svelte#readme",
  "bugs": {
    "url": "https://github.com/boxraiser/visual-editor-svelte/issues"
  },
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && npm run package",
    "package": "svelte-package -o dist",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write .",
    "lint": "prettier --check .",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "start-server-and-test 'php -S 0.0.0.0:8000 -ddisplay_errors=1 -q' http://localhost:8000 'npx cypress run'",
    "test:e2e:watch": "start-server-and-test 'php -S 0.0.0.0:8000 -ddisplay_errors=1 -q' http://localhost:8000 'npx cypress open'"
  },
  "keywords": [
    "svelte",
    "svelte5",
    "visual-editor",
    "page-builder",
    "wysiwyg",
    "cms",
    "blocks",
    "drag-and-drop",
    "web-component",
    "custom-element",
    "form-builder",
    "content-editor",
    "rich-text",
    "tiptap",
    "typescript",
    "iframe-preview",
    "live-preview",
    "component-library",
    "runes"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/boxraiser/visual-editor-svelte"
  },
  "author": "BoxRaiser",
  "license": "MIT",
  "dependencies": {
    "clsx": "^2.1.1",
    "svelte-dnd-action": "^0.9.50"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "^3.2.5",
    "@sveltejs/kit": "^2.8.5",
    "@sveltejs/package": "^2.3.7",
    "@sveltejs/vite-plugin-svelte": "^4.0.3",
    "@tiptap/core": "^3.0.7",
    "@tiptap/extension-blockquote": "^3.0.7",
    "@tiptap/extension-bold": "^3.0.7",
    "@tiptap/extension-bullet-list": "^3.0.7",
    "@tiptap/extension-color": "^3.0.7",
    "@tiptap/extension-document": "^3.0.7",
    "@tiptap/extension-hard-break": "^3.0.7",
    "@tiptap/extension-heading": "^3.0.7",
    "@tiptap/extension-highlight": "^3.0.7",
    "@tiptap/extension-history": "^3.0.7",
    "@tiptap/extension-italic": "^3.0.7",
    "@tiptap/extension-link": "^3.0.7",
    "@tiptap/extension-list-item": "^3.0.7",
    "@tiptap/extension-ordered-list": "^3.0.7",
    "@tiptap/extension-paragraph": "^3.0.7",
    "@tiptap/extension-text": "^3.0.7",
    "@tiptap/extension-text-align": "^3.0.7",
    "@tiptap/extension-text-style": "^3.0.7",
    "@tiptap/extension-underline": "^3.0.7",
    "@tiptap/pm": "^3.0.7",
    "@types/node": "^22.10.2",
    "cypress": "^15.6.0",
    "prettier": "^3.4.2",
    "prettier-plugin-svelte": "^3.3.2",
    "start-server-and-test": "^2.0.1",
    "svelte": "^5.2.10",
    "svelte-check": "^4.1.1",
    "tslib": "^2.8.1",
    "typescript": "^5.7.2",
    "vite": "^7.0.6",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "volta": {
    "node": "22.17.1"
  }
}
